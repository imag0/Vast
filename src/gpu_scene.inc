static int scene_images_pending(void){for(int i=0;i<G.imageN;i++){ImageObj*p=&G.images[i];if(!p->active||!p->px||p->pw<=0||p->ph<=0)continue;SceneImage*t=&SI[i];int total=((p->pw+SCENE_IMAGE_TILE-1)/SCENE_IMAGE_TILE)*((p->ph+SCENE_IMAGE_TILE-1)/SCENE_IMAGE_TILE);if(t->source==p->px&&t->project==G.projectIndex&&t->revision==G.imageContentRevision&&t->uploaded<total)return 1;}return 0;}
static void scene_shape(int i,ShapeObj*q,int live){
