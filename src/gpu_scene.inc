static void scene_regions(void){if(!G.regionGlow)return;float alpha=(G.regionGlow==1?12:22)/255.f;int step=maxi(1,G.strokeN/28);for(int i=0;i<G.strokeN;i+=step){Stroke*s=&G.strokes[i];if(!s->active||s->n<2)continue;float pad=us(26)/G.scale;if(!gi_visible(s->minx-pad,s->miny-pad,s->maxx+pad,s->maxy+pad))continue;scene_quad(s->minx-pad,s->miny-pad,s->maxx-s->minx+2*pad,s->maxy-s->miny+2*pad,i&1?C_VIOLET:C_ACCENT,alpha,us(34),0,0);}for(int i=0;i<G.imageN;i++){ImageObj*p=&G.images[i];if(!p->active)continue;float pad=us(20)/G.scale;if(gi_visible(p->x-pad,p->y-pad,p->x+p->w+pad,p->y+p->h+pad))scene_quad(p->x-pad,p->y-pad,p->w+2*pad,p->h+2*pad,C_CYAN,alpha+5.f/255,us(28),0,0);}}
static int scene_image_upload(SceneImage*t,ImageObj*p){
    int cols=(p->pw+SCENE_IMAGE_TILE-1)/SCENE_IMAGE_TILE,rows=(p->ph+SCENE_IMAGE_TILE-1)/SCENE_IMAGE_TILE;if(cols<=0||rows<=0||cols*rows>SCENE_IMAGE_TEXTURES)return 0;
