}
static void scene_image_tiles(SceneImage*t,ImageObj*p){float centerX=p->x+p->w*.5f,centerY=p->y+p->h*.5f,c=cosf(p->rot),s=sinf(p->rot);for(int slot=0;slot<t->uploaded;slot++){int ty=slot/t->cols,tx=slot%t->cols,tw=mini(SCENE_IMAGE_TILE,p->pw-tx*SCENE_IMAGE_TILE),th=mini(SCENE_IMAGE_TILE,p->ph-ty*SCENE_IMAGE_TILE);float ww=p->w*(float)tw/p->pw,hh=p->h*(float)th/p->ph,lx=p->x+p->w*((tx*SCENE_IMAGE_TILE+tw*.5f)/p->pw),ly=p->y+p->h*((ty*SCENE_IMAGE_TILE+th*.5f)/p->ph),dx=lx-centerX,dy=ly-centerY,rx=centerX+dx*c-dy*s,ry=centerY+dx*s+dy*c;scene_quad(rx-ww*.5f,ry-hh*.5f,ww,hh,0xffffff,1,0,t->texture[slot],p->rot);}}
